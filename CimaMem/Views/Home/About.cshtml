@{
    ViewData["Title"] = "عن المنصة والحقوق - CineWave";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card bg-dark text-white border-secondary rounded-4 shadow p-4 p-md-5">
                <h2 class="fw-bold text-danger mb-3"><i class="bi bi-info-circle-fill me-2"></i>عن منصة CineWave</h2>
                <p class="lead text-light text-opacity-75 mb-4">
                    منصة سينمائية ترفيهية تتيح تصفح واستكشاف أحدث الأفلام والمسلسلات العربية والأجنبية والتركية بمواصفات عالية وواجهة حديثة.
                </p>

                <hr class="border-secondary my-4" />

                <h4 class="fw-bold text-warning mb-3"><i class="bi bi-attrib-icon me-2"></i>حقوق ونُسب البيانات (TMDB Attribution)</h4>
                
                <div class="d-flex align-items-center gap-3 bg-black bg-opacity-50 p-3 rounded-3 border border-secondary mb-3">
                    <img src="https://www.themoviedb.org/assets/2/v4/logos/v2/blue_square_2-d537fb228cf3ded904ef09b136fe3fec72548ebc1fea3fbbd1ad9e36364db38b.svg" alt="TMDB Logo" style="width: 60px;" />
                    <div>
                        <h6 class="fw-bold text-white mb-1">The Movie Database (TMDB)</h6>
                        <p class="small text-secondary mb-0">This product uses the TMDB API but is not endorsed or certified by TMDB.</p>
                    </div>
                </div>

                <p class="text-secondary small mb-0">
                    جميع بيانات ومعلومات الملصقات، الأوصاف، الممثلين، التصنيفات والتقييمات مأخوذة ومزودة بواسطة خدمات TMDB API وفق شروط الاستخدام غير التجاري لـ TMDB.
                </p>
            </div>
        </div>
    </div>
</div>
