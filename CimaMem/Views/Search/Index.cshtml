@model List<CimaMem.Controllers.SearchSearchResultItem>
@{
    ViewData["Title"] = $"نتائج البحث عن {ViewBag.Query} - CineWave";
    string query = ViewBag.Query as string ?? "";
}

<div class="container py-4">
    <div class="mb-4">
        <h2 class="fw-bold text-white mb-1">
            <i class="bi bi-search me-2 text-danger"></i>
            @(!string.IsNullOrEmpty(query) ? $"نتائج البحث عن: \"{query}\"" : "البحث في CineWave")
        </h2>
        <p class="text-secondary mb-0">تم العثور على @Model.Count نتيجة</p>
    </div>

    @if (Model.Any())
    {
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
            @foreach (var item in Model)
            {
                var isMovie = item.Type == "Movie";
                var url = isMovie ? $"/Movie/Details/{item.Id}" : $"/Series/Details/{item.Id}";
                <div class="col">
                    <div class="media-card h-100">
                        <a href="@url" class="text-decoration-none">
                            <div class="media-card-poster">
                                <img src="@(item.PosterUrl ?? "https://via.placeholder.com/300x450")" alt="@item.Title" loading="lazy" />
                                <div class="media-card-badge"><i class="bi bi-star-fill text-warning me-1"></i>@item.Rating.ToString("0.0")</div>
                                <div class="media-card-quality @(isMovie ? "bg-danger" : "bg-success")">@(isMovie ? "فيلم" : "مسلسل")</div>
                            </div>
                            <div class="media-card-body">
                                <h6 class="media-card-title text-white">@item.Title</h6>
                                <div class="media-card-info d-flex justify-content-between align-items-center">
                                    <span>@(item.Year?.ToString() ?? "2024")</span>
                                    <span class="@(isMovie ? "text-danger" : "text-success")"><i class="bi bi-play-circle-fill"></i></span>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 my-5">
            <i class="bi bi-search fs-1 text-secondary"></i>
            <h4 class="mt-3 text-secondary">لم نجد نتائج مطابقة لـ "@query".</h4>
            <p class="text-secondary">تأكد من كتابة اسم الفيلم أو المسلسل بشكل صحيح، أو ابحث باسم آخر.</p>
            <a href="/Movies" class="btn btn-danger rounded-pill mt-3 px-4">تصفح الأفلام</a>
        </div>
    }
</div>
