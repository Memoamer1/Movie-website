@model List<CimaMem.Entities.Movie>
@using CimaMem.Entities
@{
    ViewData["Title"] = "مكتبة الأفلام - CineWave";
    var genres = ViewBag.Genres as List<Genre> ?? new List<Genre>();
    var currentGenre = ViewBag.CurrentGenre as Genre;
    string sort = ViewBag.Sort ?? "latest";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int? genreId = ViewBag.GenreId;
}

<div class="container py-4">
    <!-- Header & Filter Controls -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold text-white mb-1">
                <i class="bi bi-film me-2 text-danger"></i>
                @(currentGenre != null ? $"أفلام تصنيف: {currentGenre.Name}" : "جميع الأفلام")
            </h2>
            <p class="text-secondary mb-0">تصفح المكتبة الكاملة لأفضل الأفلام العربية والأجنبية</p>
        </div>

        <div class="d-flex gap-2">
            <!-- Sort Dropdown -->
            <form method="get" action="/Movies" class="d-flex gap-2">
                @if (genreId.HasValue)
                {
                    <input type="hidden" name="genreId" value="@genreId" />
                }
                <select name="sort" class="form-select bg-dark text-white border-secondary rounded-pill px-3" onchange="this.form.submit()">
                    <option value="latest" selected="@(sort == "latest")">أحدث الإضافات</option>
                    <option value="top_rated" selected="@(sort == "top_rated")">الأعلى تقييماً</option>
                    <option value="popular" selected="@(sort == "popular")">الأكثر شعبية</option>
                </select>
            </form>
        </div>
    </div>

    <!-- Genres Pills Filter -->
    <div class="d-flex align-items-center gap-2 overflow-auto pb-3 mb-4">
        <a href="/Movies?sort=@sort" class="btn @(genreId == null ? "btn-danger" : "btn-dark border border-secondary text-light") rounded-pill px-4 flex-shrink-0">الكل</a>
        @foreach (var g in genres)
        {
            <a href="/Movies?genreId=@g.Id&sort=@sort" class="btn @(genreId == g.Id ? "btn-danger" : "btn-dark border border-secondary text-light") rounded-pill px-3 flex-shrink-0">@g.Name</a>
        }
    </div>

    <!-- Movies Grid -->
    @if (Model.Any())
    {
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3 mb-5">
            @foreach (var movie in Model)
            {
                <div class="col">
                    <div class="media-card h-100">
                        <a href="/Movie/Details/@movie.Id" class="text-decoration-none">
                            <div class="media-card-poster">
                                <img src="@(movie.PosterUrl ?? "https://via.placeholder.com/300x450?text=No+Poster")" alt="@movie.Title" loading="lazy" />
                                <div class="media-card-badge"><i class="bi bi-star-fill text-warning me-1"></i>@movie.Rating.ToString("0.0")</div>
                                <div class="media-card-quality">HD</div>
                            </div>
                            <div class="media-card-body">
                                <h6 class="media-card-title text-white">@movie.Title</h6>
                                <div class="media-card-info d-flex justify-content-between align-items-center">
                                    <span>@(movie.ReleaseDate?.Year.ToString() ?? "2024")</span>
                                    <span class="text-danger"><i class="bi bi-play-circle-fill"></i></span>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <nav class="d-flex justify-content-center mt-4">
                <ul class="pagination pagination-dark gap-1">
                    @if (currentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link bg-dark border-secondary text-white rounded-circle" href="/Movies?page=@(currentPage - 1)&genreId=@genreId&sort=@sort"><i class="bi bi-chevron-right"></i></a>
                        </li>
                    }

                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link @(p == currentPage ? "bg-danger border-danger text-white" : "bg-dark border-secondary text-white") rounded-circle" href="/Movies?page=@p&genreId=@genreId&sort=@sort">@p</a>
                        </li>
                    }

                    @if (currentPage < totalPages)
                    {
                        <li class="page-item">
                            <a class="page-link bg-dark border-secondary text-white rounded-circle" href="/Movies?page=@(currentPage + 1)&genreId=@genreId&sort=@sort"><i class="bi bi-chevron-left"></i></a>
                        </li>
                    }
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="text-center py-5 my-5">
            <i class="bi bi-film fs-1 text-secondary"></i>
            <h4 class="mt-3 text-secondary">لا توجد أفلام مطابقة لخيارات البحث.</h4>
            <a href="/Movies" class="btn btn-danger rounded-pill mt-3 px-4">عرض جميع الأفلام</a>
        </div>
    }
</div>
