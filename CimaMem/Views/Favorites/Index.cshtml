@model List<CimaMem.Entities.Favorite>
@{
    ViewData["Title"] = "قائمة المفضلة - CineWave";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-white mb-1"><i class="bi bi-heart-fill me-2 text-danger"></i>قائمة المفضلة الخاصة بك</h2>
            <p class="text-secondary mb-0">جميع الأفلام والمسلسلات التي قمت بحفظها للمشاهدة لاحقاً</p>
        </div>
        <span class="badge bg-danger rounded-pill px-3 py-2 fs-6">@Model.Count عنصر في المفضلة</span>
    </div>

    @if (Model.Any())
    {
        <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-6 g-3">
            @foreach (var fav in Model)
            {
                var isMovie = fav.Movie != null;
                var itemTitle = isMovie ? fav.Movie!.Title : fav.Series!.Title;
                var itemPoster = isMovie ? fav.Movie!.PosterUrl : fav.Series!.PosterUrl;
                var itemRating = isMovie ? fav.Movie!.Rating : fav.Series!.Rating;
                var itemUrl = isMovie ? $"/Movie/Details/{fav.MovieId}" : $"/Series/Details/{fav.SeriesId}";
                var itemYear = isMovie ? fav.Movie!.ReleaseDate?.Year : fav.Series!.FirstAirDate?.Year;

                <div class="col" id="fav-card-@fav.Id">
                    <div class="media-card h-100">
                        <a href="@itemUrl" class="text-decoration-none">
                            <div class="media-card-poster">
                                <img src="@(itemPoster ?? "https://via.placeholder.com/300x450")" alt="@itemTitle" loading="lazy" />
                                <div class="media-card-badge"><i class="bi bi-star-fill text-warning me-1"></i>@itemRating.ToString("0.0")</div>
                                <div class="media-card-quality @(isMovie ? "bg-danger" : "bg-success")">@(isMovie ? "فيلم" : "مسلسل")</div>
                            </div>
                            <div class="media-card-body">
                                <h6 class="media-card-title text-white">@itemTitle</h6>
                                <div class="media-card-info d-flex justify-content-between align-items-center">
                                    <span>@(itemYear?.ToString() ?? "2024")</span>
                                    <button type="button" class="btn btn-sm btn-link text-danger p-0" onclick="removeFav(event, @(isMovie ? fav.MovieId : 0), @(!isMovie ? fav.SeriesId : 0), 'fav-card-@fav.Id')">
                                        <i class="bi bi-trash3-fill"></i>
                                    </button>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 my-5">
            <i class="bi bi-heartbreak fs-1 text-secondary"></i>
            <h4 class="mt-3 text-secondary">قائمة المفضلة فارغة حالياً.</h4>
            <p class="text-secondary">قم بتصفح الأفلام والمسلسلات واضغط على رمز المفضلة لحفظ عناصرك المفضلة هنا.</p>
            <a href="/Movies" class="btn btn-danger rounded-pill mt-3 px-4 me-2">تصفح الأفلام</a>
            <a href="/Series" class="btn btn-success rounded-pill mt-3 px-4">تصفح المسلسلات</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        function removeFav(event, movieId, seriesId, cardId) {
            event.preventDefault();
            event.stopPropagation();

            const url = movieId > 0 ? '/Favorites/ToggleMovie' : '/Favorites/ToggleSeries';
            const bodyData = movieId > 0 ? `movieId=${movieId}` : `seriesId=${seriesId}`;

            fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: bodyData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const elem = document.getElementById(cardId);
                    if (elem) elem.remove();
                }
            });
        }
    </script>
}
