@model CimaMem.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "الملف الشخصي";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-8 col-lg-6">
        <div class="card bg-dark text-white border-secondary shadow-lg rounded-4">
            <div class="card-body p-4 p-md-5 text-center">
                <img src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "https://via.placeholder.com/150" : Model.AvatarUrl)" 
                     alt="Avatar" class="rounded-circle mb-3 shadow border border-secondary" style="width: 120px; height: 120px; object-fit: cover;" />
                <h3 class="fw-bold mb-1 text-white">@Model.UserName</h3>
                <p class="text-secondary mb-3">@Model.Email</p>

                @if (Model.IsAdmin)
                {
                    <span class="badge bg-danger fs-6 mb-3 px-3 py-2 rounded-pill"><i class="bi bi-shield-lock me-1"></i> مسؤول النظام (Admin)</span>
                }
                else
                {
                    <span class="badge bg-secondary fs-6 mb-3 px-3 py-2 rounded-pill"><i class="bi bi-person me-1"></i> مستخدم</span>
                }

                <div class="mt-4 pt-3 border-top border-secondary d-flex justify-content-center gap-3">
                    @if (Model.IsAdmin)
                    {
                        <a href="/Admin" class="btn btn-warning rounded-pill px-4 fw-bold">لوحة التحكم (Admin)</a>
                    }
                    <form asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger rounded-pill px-4">تسجيل الخروج</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
